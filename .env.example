NODE_ENV=development
PORT=3000
# API path prefix; empty disables it. Leading/trailing slashes are normalized.
API_PREFIX=api
# Required: use a random secret of at least 32 characters.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=604800
# Exact frontend origin; no trailing slash. Update the port to match your frontend.
CLIENT_ORIGIN=http://localhost:5173

# Optional until chat is used. Keep the real key in your local .env only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=nest_agent
DATABASE_URL=postgresql://postgres:123456@localhost:5432/nest_agent
# E2E tests migrate and clear this separate database. Create it before testing.
TEST_DATABASE_URL=postgresql://postgres:123456@localhost:5432/nest_agent_test
